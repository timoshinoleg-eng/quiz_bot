{
	email {$ACME_EMAIL}
	admin off
}

{$PUBLIC_HOST} {
	encode zstd gzip
	request_body {
		max_size 1MB
	}
	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "frame-ancestors 'self' https://*.max.ru https://web.max.ru"
	}
	reverse_proxy app:8000
}
