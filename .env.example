# Canonical MAX bot token. MAX_BOT_TOKEN is accepted only for old local setups.
BOT_TOKEN=replace_with_max_token
BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=replace_with_telegram_token
TELEGRAM_BOT_USERNAME=your_telegram_bot_username
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=replace_with_a_random_long_secret
BOT_MODE=polling
ENV=development
MINI_APP_URL=http://localhost:5173
APP_SESSION_SECRET=replace_with_a_random_long_secret
DEBUG=false
LOG_LEVEL=INFO

# SQLite is the zero-setup local beta default.
DATABASE_URL=sqlite+aiosqlite:///./quiz_bot.db

# Hosted beta: use PostgreSQL instead.
# DATABASE_URL=postgresql+asyncpg://quiz_user:strong_password@localhost:5432/quiz_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

ANSWER_TIMEOUT=30
MAX_LIVES=3
DAILY_QUESTION_COUNT=5
CHALLENGE_QUESTION_COUNT=5
ENABLE_STREAKS=true

# Optional webhook configuration. Polling is the supported local beta path.
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
POLLING_TIMEOUT=30
