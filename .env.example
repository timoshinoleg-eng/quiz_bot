# Canonical MAX bot token. MAX_BOT_TOKEN is accepted only for old local setups.
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
MAX_WEBHOOK_URL=
MAX_WEBHOOK_PATH=/webhooks/max
MAX_WEBHOOK_SECRET=
BOT_MODE=webhook
ENV=production
MINI_APP_URL=
WEBAPP_BASE_URL=
API_BASE_URL=
CORS_ORIGINS=
APP_SESSION_SECRET=
DEBUG=false
LOG_LEVEL=INFO

# Production: a private Managed PostgreSQL endpoint only.
DATABASE_URL=
PG_DSN=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

ANSWER_TIMEOUT=30
MAX_LIVES=3
DAILY_QUESTION_COUNT=7
CHALLENGE_QUESTION_COUNT=5
ENABLE_STREAKS=true

# Local-only overrides: use a separate ignored .env.local, not this file.
# BOT_MODE=polling
# ENV=development
# DATABASE_URL=sqlite+aiosqlite:///./quiz_bot.db
POLLING_TIMEOUT=30
